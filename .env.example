# Copy to .env for local development. Never commit real values.

# --- Backend ---
APP_ENV=local
LOG_LEVEL=INFO
# Async SQLAlchemy DSN. Host "db" matches the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://finance:finance@db:5432/finance
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-every-real-environment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTRY_DSN=

# --- Frontend (Vite; only VITE_* is exposed to the browser) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=

# --- Local Postgres (docker-compose) ---
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# --- Local docker-compose host ports ---
# Override if these collide with other services on your machine.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
